# =============================================================================
# Sol — environment variables
# Copy to `.env.local` and fill in. Defaults make `pnpm dev` work with no creds.
# =============================================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Sol

# --- Commerce ---
# mock | shopify
COMMERCE_PROVIDER=mock
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_TOKEN=
SHOPIFY_API_VERSION=2024-10

# --- Email ---
# console | klaviyo | resend | mailchimp
EMAIL_PROVIDER=console
EMAIL_CONTACT_INBOX=hello@solkava.com
EMAIL_WHOLESALE_INBOX=wholesale@solkava.com
KLAVIYO_PRIVATE_KEY=
KLAVIYO_NEWSLETTER_LIST_ID=
RESEND_API_KEY=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# --- Analytics ---
# Comma-separated subset of: ga4,posthog,meta,tiktok,segment
ANALYTICS_PROVIDERS=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SEGMENT_WRITE_KEY=

# --- Shipping (future) ---
# stub | amazon_mcf | shipbob | shipstation
SHIPPING_PROVIDER=stub
AMAZON_MCF_ACCESS_KEY=
SHIPBOB_API_KEY=
SHIPSTATION_API_KEY=

# --- Locations (future) ---
# mock | shopify_metaobject | csv | google_places
LOCATIONS_PROVIDER=mock
GOOGLE_PLACES_API_KEY=

# --- CMS ---
# local | sanity | contentful | shopify_metaobject
CMS_PROVIDER=local
SANITY_PROJECT_ID=
SANITY_DATASET=
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=
